---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
  <h1 class="post-title">
    {{ page.heading | default: page.title }}
  </h1>
  {% if page.sponsor_imgs or page.sponsor_img %}
    <div class="project-sponsors-row">
      {% if page.sponsor_imgs %}
        {% for img in page.sponsor_imgs %}
          {% include figure.liquid path=img class="img-fluid project-sponsor-logo" %}
        {% endfor %}
      {% else %}
        {% include figure.liquid path=page.sponsor_img class="img-fluid project-sponsor-logo" %}
      {% endif %}
    </div>
  {% endif %}
  <p class="post-description">
    {% if page.subheading %}{{ page.subheading }}{% endif %}
  </p>
  </header>
  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>Publications</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
