---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
  <h1 class="post-title">
    {{ page.heading | default: page.title }}
  </h1>
  {% if page.sponsor_imgs or page.sponsor_img %}
  <div class="project-sponsors-row">
    {% if page.sponsor_imgs %}
      {% for img in page.sponsor_imgs %}
        <img src="{{ img | relative_url }}" class="img-fluid project-sponsor-logo" alt="Research sponsor">
      {% endfor %}
    {% else %}
      <img src="{{ page.sponsor_img | relative_url }}" class="img-fluid project-sponsor-logo" alt="Research sponsor">
    {% endif %}
  </div>
  {% endif %}
  <p class="post-description">
    {% if page.subheading %}{{ page.subheading }}{% endif %}
  </p>
  </header>
  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>Publications</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
